# Secrets only. Never commit a real .env file.
PIA_ENV=dev
PIA_ANTHROPIC_API_KEY=
PIA_DATABASE_URL=postgresql+psycopg://pia:pia@localhost:5432/pia
PIA_REDIS_URL=redis://localhost:6379/0
# stage/prod identity provider
PIA_OIDC_ISSUER=
PIA_OIDC_AUDIENCE=
PIA_OIDC_JWKS_URL=
# dev only: key:user:team1+team2:human|service, comma separated. Refused in prod.
PIA_API_KEYS=dev-alice-key:alice:project+risk:human,dev-gina-key:gina:governance:human,dev-rita-key:rita:risk+infosec+privacy:human,dev-bob-key:bob:business_owner:human,dev-drafter-key:drafter:project:service,dev-auditor-key:auditor:audit:human
